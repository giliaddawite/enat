# Copy to .env and fill in. Never commit .env — it is gitignored, and CI runs
# gitleaks (TICKET-002) to catch anything that slips through.
#
# This file mirrors backend/.env.example, which is the canonical list: every
# key here is one backend/src/config.ts actually reads. When a variable is
# added to config.ts, add it to both files in the same change. Values marked
# (secret) live in Secret Manager in staging and prod; .env is a
# local-development convenience only.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# development | test | production
NODE_ENV=development
# Cloud Run injects PORT automatically.
PORT=8080
# debug | info | warn | error
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Google Cloud (TICKET-003)
# ---------------------------------------------------------------------------
# Required when NODE_ENV=production: Cloud Trace log correlation, and the
# project Secret Manager refresh tokens are stored in.
GCP_PROJECT_ID=
# Path to a local service-account key. Prefer `gcloud auth application-default
# login` instead; only set this if ADC is unavailable. Read by the Google SDKs,
# not by config.ts.
GOOGLE_APPLICATION_CREDENTIALS=
# Host:port of the local Firestore emulator. Leave empty to hit real Firestore.
# Read by the Firestore SDK, not by config.ts.
FIRESTORE_EMULATOR_HOST=

# ---------------------------------------------------------------------------
# Authentication (TICKET-102)
# ---------------------------------------------------------------------------
# Comma-separated Google OAuth client ID(s) an inbound ID token's `aud` must
# match — the Android app's client ID(s). Required when NODE_ENV=production.
# Not a secret. List two while rotating in a new one.
GOOGLE_OAUTH_AUDIENCE=
# Requests per authenticated user per 60s before 429. Defaults to 60.
RATE_LIMIT_PER_MINUTE=60

# ---------------------------------------------------------------------------
# Digest generation (TICKET-104, 105, 202) — all optional, even in production:
# the service boots and serves reads without them; generation answers a clear
# 5xx until they are set.
# ---------------------------------------------------------------------------
# Anthropic API key for the digest summarizer.
CLAUDE_API_KEY=                      # (secret)
# The Gmail OAuth client the Android consent flow requests its server auth
# code for. The backend exchanges that code for the refresh token (stored in
# Secret Manager — no KMS key to configure) and later mints access tokens.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=          # (secret)

# ---------------------------------------------------------------------------
# Scheduled generation (TICKET-105)
# ---------------------------------------------------------------------------
# Expected `aud` and `email` claims on the OIDC token Pub/Sub attaches to a
# push to /internal/digest-generate. Both required together; either alone
# leaves the endpoint unmounted. See infra/README.md.
PUBSUB_PUSH_AUDIENCE=
PUBSUB_INVOKER_SERVICE_ACCOUNT_EMAIL=
