# Copy to .env and fill in. Never commit .env — it is gitignored, and CI runs
# gitleaks (TICKET-002) to catch anything that slips through.
#
# Values marked (secret) live in Secret Manager in staging and prod; .env is a
# local-development convenience only.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Google Cloud (TICKET-003)
# ---------------------------------------------------------------------------
GCP_PROJECT_ID=
GCP_REGION=
# Path to a local service-account key. Prefer `gcloud auth application-default
# login` instead; only set this if ADC is unavailable.
GOOGLE_APPLICATION_CREDENTIALS=

# ---------------------------------------------------------------------------
# Firestore (TICKET-102, 104, 105)
# ---------------------------------------------------------------------------
FIRESTORE_DATABASE_ID=
# Host:port of the local Firestore emulator. Leave empty to hit real Firestore.
FIRESTORE_EMULATOR_HOST=

# ---------------------------------------------------------------------------
# Google OAuth / Gmail (TICKET-003, 102, 103)
# ---------------------------------------------------------------------------
# Backend OAuth client — exchanges the Android server auth code for a refresh
# token. Scopes are limited to gmail.readonly + gmail.modify.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=          # (secret)
# Android OAuth client ID. The backend verifies incoming ID tokens against this
# audience; it is not itself a secret.
GOOGLE_ANDROID_CLIENT_ID=
# KMS key used to encrypt stored Gmail refresh tokens at rest.
REFRESH_TOKEN_KMS_KEY=

# ---------------------------------------------------------------------------
# Anthropic / summarization (TICKET-104)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=                   # (secret)
ANTHROPIC_MODEL=
# Hard cap on input tokens per digest batch. Emails past the cap fall back to
# heuristic categorization rather than being summarized.
DIGEST_MAX_INPUT_TOKENS=
DIGEST_BATCH_SIZE=

# ---------------------------------------------------------------------------
# Digest scheduling (TICKET-105)
# ---------------------------------------------------------------------------
DIGEST_SCHEDULE_CRON=
DIGEST_TIMEZONE=
DIGEST_PUBSUB_TOPIC=

# ---------------------------------------------------------------------------
# Rate limiting (TICKET-102)
# ---------------------------------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=
