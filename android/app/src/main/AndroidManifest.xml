<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ runtime permission for the daily verse reminder (TICKET-205).
         Requested once, as the setup flow's final step; a denial is respected —
         the app never nags and works fully without notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Package-visibility declaration (Android 11+): without it, the digest
         detail's package-pinned Gmail intent throws ActivityNotFoundException
         even when Gmail is installed. The pin itself stays — an unpinned
         https intent could be intercepted by another app. -->
    <queries>
        <package android:name="com.google.android.gm" />
    </queries>

    <!-- allowBackup stays off so Auto Backup can never ship cached email digests
         or tokens to Drive (the Room cache exists as of TICKET-203/204), and
         dataExtractionRules extends the same exclusion to Android 12+ cloud
         backup AND device-to-device transfer, which ignores allowBackup.
         usesCleartextTraffic is defense-in-depth: every backend URL is https. -->
    <application
        android:name=".EnatApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Enat"
        android:usesCleartextTraffic="false">

        <!-- Crash reporting never starts on its own: EnatApplication enables it
             explicitly, and only in release builds. -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
