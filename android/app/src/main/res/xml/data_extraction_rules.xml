<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing on this device may leave it through system data extraction: the Room
     cache holds email-derived summaries. allowBackup=false already blocks cloud
     backup on Android 11 and below, but Android 12+ device-to-device transfer
     ignores that flag, so both channels are excluded explicitly here. Every
     domain is listed — excluding only "root" would still let the database and
     shared-preference domains through. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
