# Copy to .env for local notes only; the service reads real values from the process
# environment (Cloud Run env vars). Never commit filled-in values.

# Port the HTTP server binds to. Cloud Run injects this automatically.
PORT=8080

# development | test | production
NODE_ENV=development

# debug | info | warn | error
LOG_LEVEL=info

# GCP project ID. Required when NODE_ENV=production; used to correlate log entries
# with Cloud Trace. Provisioned by TICKET-003.
GCP_PROJECT_ID=

# Comma-separated Google OAuth client ID(s). An inbound ID token's `aud` claim must match
# one of these. Required when NODE_ENV=production. List two values while rotating in a new
# client ID (e.g. a new Play Store release) so the old one keeps working until it is retired.
GOOGLE_OAUTH_AUDIENCE=

# Requests allowed per authenticated user per 60s window before the API returns 429.
# Protects the per-request Claude API budget. Defaults to 60.
RATE_LIMIT_PER_MINUTE=60

# --- Digest generation (TICKET-105) ---
# All of the following are optional, even in production: the service boots and serves
# /healthz and reads of already-generated digests without them. Missing config only turns
# POST /v1/digest/generate and the scheduled job into a clear 5xx, never a boot failure.

# Anthropic API key for the digest summarizer (TICKET-104).
CLAUDE_API_KEY=

# The Gmail OAuth client the Android consent flow requests its server auth code for
# (TICKET-202) — used by POST /v1/auth/gmail-consent to exchange that code and store the
# refresh token, and later to mint Gmail access tokens from it. Without these (or
# GCP_PROJECT_ID), the consent endpoint and digest generation answer a clear 5xx.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Expected `aud` and `email` claims on the OIDC token Pub/Sub attaches to a push request to
# /internal/digest-generate. Both required together; either alone leaves the endpoint
# unmounted. See infra/README.md for how the push subscription sets these.
PUBSUB_PUSH_AUDIENCE=
PUBSUB_INVOKER_SERVICE_ACCOUNT_EMAIL=
