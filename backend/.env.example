# Copy to .env for local notes only; the service reads real values from the process
# environment (Cloud Run env vars). Never commit filled-in values.

# Port the HTTP server binds to. Cloud Run injects this automatically.
PORT=8080

# development | test | production
NODE_ENV=development

# debug | info | warn | error
LOG_LEVEL=info

# GCP project ID. Required when NODE_ENV=production; used to correlate log entries
# with Cloud Trace. Provisioned by TICKET-003.
GCP_PROJECT_ID=
