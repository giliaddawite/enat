# Copy to .env for local notes only; the service reads real values from the process
# environment (Cloud Run env vars). Never commit filled-in values.

# Port the HTTP server binds to. Cloud Run injects this automatically.
PORT=8080

# development | test | production
NODE_ENV=development

# debug | info | warn | error
LOG_LEVEL=info

# GCP project ID. Required when NODE_ENV=production; used to correlate log entries
# with Cloud Trace. Provisioned by TICKET-003.
GCP_PROJECT_ID=

# Comma-separated Google OAuth client ID(s). An inbound ID token's `aud` claim must match
# one of these. Required when NODE_ENV=production. List two values while rotating in a new
# client ID (e.g. a new Play Store release) so the old one keeps working until it is retired.
GOOGLE_OAUTH_AUDIENCE=

# Requests allowed per authenticated user per 60s window before the API returns 429.
# Protects the per-request Claude API budget. Defaults to 60.
RATE_LIMIT_PER_MINUTE=60
